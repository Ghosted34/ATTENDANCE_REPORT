# Local browser/server mode only. Electron uses the settings window and config.json instead.
# Copy this file to .env, then paste the SQL Server connection string below.
# The whole database configuration is this one string; set the host, database, user and
# password inside it. If the password contains '#', wrap the value in double quotes.
#   Server=192.168.1.10,1433;Database=VIAC;User Id=reports;Password=…;TrustServerCertificate=True
DB_CONNECTION_STRING=

# Local time offset from UTC, in whole hours (1 for Nigeria).
TZ_OFFSET_HOURS=1

# Local HTTP port; the server binds to 127.0.0.1 only.
PORT=3000
