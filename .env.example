# Local development settings. Copy to `.env` and fill in:
#
#     cp .env.example .env
#
# Read by BOTH local entry points:
#   * `npm run dev`  — the server on its own, for working in a browser (no Electron)
#   * `npm start`    — the desktop app run from source
#
# The packaged desktop app ignores this file entirely: it keeps its settings in
# <userData>/config.json with the password encrypted by Electron's safeStorage, and you
# set them via File > Database settings.
#
# A variable set in your shell (e.g. `DB_HOST=10.0.0.5 npm run dev`) beats the value here.

DB_HOST=192.168.1.10
DB_PORT=1433
DB_NAME=AccessControl
DB_USER=reports
DB_PASSWORD=
TZ_OFFSET_HOURS=1

# Dev server only. HOST defaults to 127.0.0.1 — leave it there: with no Electron there is
# no API token, so anything beyond loopback would be an open door to the database.
PORT=3000
