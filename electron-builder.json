{
  "appId": "com.reportsdesk.app",
  "productName": "Reports Desk",
  "icon": "assets/icon.png",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main/**/*",
    "server/**/*",
    "renderer/**/*",
    "brand.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
